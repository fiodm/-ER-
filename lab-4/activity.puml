
@startuml
title UC04 — Процес оплати замовлення

|Покупець|
start
:Ініціювати оплату замовлення;

|Система онлайн-магазину|
:Отримати Order, OrderItem та Payment;

if (Order.status == paid?) then (так)
  :Відхилити повторну оплату;
  |Покупець|
  :Отримати повідомлення "Вже оплачено";

else (ні)
  |Система онлайн-магазину|

  if (Order.status == pending та\nPayment відсутній або failed?) then (так)

    :Розрахувати суму за OrderItem;
    :createPayment(orderId, amount)>;

    |Зовнішній платіжний сервіс|
    if (Запит оброблено до тайм-ауту?) then (так)
      :Прийняти createPayment;
      :Створити платіжне посилання;
      :paymentUrl>;

      |Система онлайн-магазину|
      :paymentUrl<;

      |Покупець|
      :Перейти за платіжним посиланням;
      :Виконати оплату;

      |Зовнішній платіжний сервіс|
      if (Callback надіслано до тайм-ауту?) then (так)
        :paymentCallback>;

        |Система онлайн-магазину|
        :paymentCallback<;
        :Перевірити підпис повідомлення;

        if (Підпис дійсний?) then (так)
          :Отримати актуальні Order та Payment;

          if (Результат уже оброблено?) then (так)
            :Не змінювати результат платежу;
            :Підтвердити повторний callback;

          else (ні)
            if (Результат success?) then (так)
              fork
                :Зберегти або оновити Payment\nзі статусом success;
                :Оновити Order.status = paid;
              fork again
                :Підготувати повідомлення\nпро успішну оплату;
              end fork

              :Перевірити збережений статус paid;
              :Надіслати повідомлення покупцю;

            else (ні)
              :Зберегти або оновити Payment\nзі статусом failed;
              :Залишити Order.status = pending;
              :Надіслати повідомлення про відмову;
            endif

            :Підтвердити обробку callback;
          endif

        else (ні)
          :Відхилити недійсний callback;
        endif

      else (ні)
        |Система онлайн-магазину|
        :Зафіксувати тайм-аут callback;
        :Не підтверджувати успішну оплату;
        :Залишити Order.status = pending;
      endif

    else (ні)
      |Система онлайн-магазину|
      :Зафіксувати тайм-аут createPayment;
      :Не відкривати сторінку оплати;
      :Залишити Order.status = pending;
      :Повідомити покупця про помилку;
    endif

  else (ні)
    :Відхилити ініціювання оплати;
  endif
endif

stop
@enduml
