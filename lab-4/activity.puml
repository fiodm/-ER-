
@startuml
title UC04 — Процес оплати замовлення

|Покупець|
start
:Ініціювати оплату замовлення;

|Система онлайн-магазину|
:Отримати Order, OrderItem та Payment;

if (Order.status == paid?) then (так)
  :Відхилити повторну оплату;
  |Покупець|
  :Отримати повідомлення "Вже оплачено";
else (ні)
  |Система онлайн-магазину|
  if (Order.status == pending та Payment відсутній або failed?) then (так)
    :Розрахувати суму за OrderItem;
   :createPayment(orderId, amount)>;

    |Зовнішній платіжний сервіс|
    :Прийняти createPayment;
    :Створити платіжне посилання;
  :paymentUrl>;

    |Система онлайн-магазину|
    :paymentUrl<;

    |Покупець|
    :Перейти за посиланням;
    :Виконати оплату;

    |Зовнішній платіжний сервіс|
    if (Callback надіслано?) then (так)
      :paymentCallback>;

      |Система онлайн-магазину|
      :paymentCallback<;
      :Перевірити підпис;

      if (Підпис дійсний?) then (так)
        :Отримати актуальні Order та Payment;

        if (Платіж уже оброблено?) then (так)
          :Не створювати повторний Payment;
          :Підтвердити обробку callback;
        else (ні)
          if (Результат success?) then (так)
            fork
              :Зберегти Payment(status=success);
              :Оновити Order.status=paid;
            fork again
              :Підготувати повідомлення покупцю;
            end fork
            :Перевірити Order.status=paid;
            :Надіслати повідомлення про успіх;
          else (ні)
            :Зберегти Payment(status=failed);
            :Залишити Order.status=pending;
            :Надіслати повідомлення про відмову;
          endif
          :Підтвердити обробку callback;
        endif
      else (ні)
        :Відхилити недійсний callback;
      endif

    else (ні)
      |Система онлайн-магазину|
      :Зафіксувати тайм-аут очікування;
      :Залишити Order без підтвердження оплати;
    endif

  else (ні)
    :Відхилити ініціювання оплати;
  endif
endif

stop
@enduml
