
@startuml
title UC04 — Процес оплати замовлення

|Покупець|
start
:Ініціювати оплату замовлення;

|Система онлайн-магазину|
:Отримати Order, OrderItem та Payment;

if (Замовлення вже оплачене?) then (так)
  :Відхилити повторну оплату;
  |Покупець|
  :Отримати повідомлення "Вже оплачено";
  stop
else (ні)
  if (Оплата дозволена?) then (так)
    :Розрахувати суму замовлення;
    :Надіслати createPayment(orderId, amount);
    |Зовнішній платіжний сервіс|
    :Прийняти запит на створення платежу;
    :Повернути paymentUrl;
    |Система онлайн-магазину|
    :Отримати paymentUrl;
    |Покупець|
    :Перейти за посиланням та виконати оплату;

    |Зовнішній платіжний сервіс|
    :Надіслати сигнал paymentCallback;
    |Система онлайн-магазину|
    if (Callback надійшов?) then (так)
      :Прийняти подію paymentCallback;
      :Перевірити підпис повідомлення;
      if (Підпис дійсний?) then (так)
        if (Платіж успішний?) then (так)
          fork
            :Зберегти Payment(status=success);
            :Оновити Order.status=paid;
          fork again
            :Підготувати повідомлення про успіх;
          end fork
          :Перевірити збережений статус paid;
          :Надіслати підтвердження покупцю;
        else (ні)
          :Зберегти Payment(status=failed);
          :Залишити Order.status=pending;
          :Надіслати повідомлення про відмову;
        endif
      else (ні)
        :Відхилити недійсний callback;
      endif
    else (ні)
      :Зафіксувати відсутність відповіді;
      :Залишити замовлення без підтвердження оплати;
    endif
  else (ні)
    :Відхилити ініціювання оплати;
  endif
endif

stop
@enduml
