
@startuml
left to right direction
skinparam packageStyle rectangle

actor "Користувач" as User
actor "Покупець" as Customer
actor "Адміністратор" as Admin
actor "Платіжний сервіс" as PaymentService

User <|-- Customer
User <|-- Admin

rectangle "Онлайн-магазин" {
  usecase "Переглянути каталог" as UC01
  usecase "Переглянути товар" as UC02
  usecase "Оформити замовлення" as UC03
  usecase "Оплатити замовлення" as UC04
  usecase "Додати товар" as UC05
  usecase "Оновити статус замовлення" as UC06
}

User --> UC01
User --> UC02

Customer --> UC03
Customer --> UC04

Admin --> UC05
Admin --> UC06

PaymentService --> UC04

UC02 ..> UC01 : <<extend>>

@enduml
