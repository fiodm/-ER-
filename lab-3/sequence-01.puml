
@startuml
title UC04 — Ініціювання оплати

actor "Покупець" as Customer
participant "Вебінтерфейс" as UI
participant "Сервіс оплати" as PaymentService
database "База даних PostgreSQL" as DB
participant "Зовнішній платіжний сервіс" as Gateway

Customer -> UI: initiatePayment(orderId)
activate UI

UI -> PaymentService: initiatePayment(orderId)
activate PaymentService

PaymentService -> DB: getOrderWithItems(orderId)
activate DB
DB --> PaymentService: Order, OrderItem[]
deactivate DB

alt Order.status == pending і оплата дозволена
    PaymentService -> PaymentService: calculateTotal(quantity * unit_price)

    PaymentService -> Gateway: createPayment(orderId, amount)
    activate Gateway
    Gateway --> PaymentService: paymentUrl
    deactivate Gateway

    PaymentService --> UI: paymentUrl
    UI --> Customer: Перехід до оплати
else Замовлення не підходить для оплати
    PaymentService --> UI: paymentRejected(reason)
    UI --> Customer: Повідомлення про помилку
end

deactivate PaymentService
deactivate UI

@enduml
